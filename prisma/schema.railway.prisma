  created_at    DateTime @default(now())
  updated_at    DateTime

  @@index([is_active])
}

model surge_rules {
  id                       Int      @id @default(autoincrement())
  tier                     AreaTier @unique
  immediate_within_minutes Int      @default(240)
  immediate_pct            Decimal  @default(0) @db.Decimal(5, 2)
  standard_pct             Decimal  @default(0) @db.Decimal(5, 2)
  is_active                Boolean  @default(true)

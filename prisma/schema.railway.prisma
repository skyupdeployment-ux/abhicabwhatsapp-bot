  @@index([booking_id])
  @@index([status, created_at])
}

model refresh_tokens {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.Char(64)
  expires_at DateTime
  revoked_at DateTime?
  user_agent String?   @db.VarChar(255)
  ip         String?   @db.VarChar(45)
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@index([user_id])
}

model rental_packages {
  id             Int      @id @default(autoincrement())
  city_id        Int
  vehicle_class  String   @db.VarChar(24)
  label          String   @db.VarChar(40)
  included_hours Int
  included_km    Int
  package_fare   Decimal  @db.Decimal(10, 2)
  extra_per_hour Decimal  @db.Decimal(10, 2)
  extra_per_km   Decimal  @db.Decimal(10, 2)
  sort_order     Int      @default(0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  cities         cities   @relation(fields: [city_id], references: [id])

  @@index([city_id, vehicle_class, is_active])
}

model role_permissions {
  id         Int    @id @default(autoincrement())
  role       Role
  permission String @db.VarChar(48)

  @@unique([role, permission])
  @@index([role])
}

model service_areas {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(80)

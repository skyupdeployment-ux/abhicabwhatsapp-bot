model vehicles {
  id                  String        @id @db.Uuid
  registration_number String        @unique @db.VarChar(16)
  vehicle_class       String        @db.VarChar(24)
  make_model          String?       @db.VarChar(80)
  year                Int?
  colour              String?       @db.VarChar(40)
  seating_capacity    Int           @default(4)
  status              VehicleStatus @default(AVAILABLE)
  city_id             Int?
  insurance_expiry    DateTime?     @db.Date
  fitness_expiry      DateTime?     @db.Date
  permit_expiry       DateTime?     @db.Date
  puc_expiry          DateTime?     @db.Date
  documents           Json          @default("{}")
  odometer_km         Int           @default(0)
  is_active           Boolean       @default(true)
  created_at          DateTime      @default(now())
  updated_at          DateTime
  is_temporary        Boolean       @default(false)
  allocations         allocations[]
  drivers             drivers[]
  cities              cities?       @relation(fields: [city_id], references: [id])

  @@index([city_id])
  @@index([is_temporary])
  @@index([status])
  @@index([vehicle_class, status])
}

model webhook_events {
  id           String    @id @db.Uuid
  provider     String    @db.VarChar(24)
  event_id     String    @db.VarChar(160)
  event_type   String    @db.VarChar(80)
  payload      Json
  signature    String?   @db.VarChar(255)
  processed_at DateTime?
  failed_at    DateTime?
  error        String?
  attempts     Int       @default(0)
  received_at  DateTime  @default(now())

  @@unique([provider, event_id])
  @@index([processed_at])
}


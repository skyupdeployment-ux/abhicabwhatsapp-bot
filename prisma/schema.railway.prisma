  @@index([booking_id])
  @@index([entry_type, created_at])
  @@index([user_id, created_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id                  String         @id @db.Uuid
  booking_id          String         @db.Uuid
  provider            String         @db.VarChar(24)
  provider_order_id   String?        @db.VarChar(120)
  provider_payment_id String?        @db.VarChar(120)
  amount              Decimal        @db.Decimal(12, 2)
  currency            String         @default("INR") @db.Char(3)
  method              PaymentMethod?
  status              PaymentStatus  @default(CREATED)
  purpose             String         @db.VarChar(20)
  raw_response        Json           @default("{}")
  failure_reason      String?        @db.VarChar(255)

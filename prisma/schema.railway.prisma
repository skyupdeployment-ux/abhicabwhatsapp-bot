}

model trip_events {
  id          String   @id @db.Uuid
  booking_id  String   @db.Uuid
  event_type  String   @db.VarChar(40)
  lat         Decimal? @db.Decimal(10, 7)
  lng         Decimal? @db.Decimal(10, 7)
  odometer_km Int?
  note        String?
  meta        Json     @default("{}")
  occurred_at DateTime @default(now())
  bookings    bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id, occurred_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model trip_reviews {
  booking_id  String    @id @db.Uuid
  customer_id String    @db.Uuid
  driver_id   String?   @db.Uuid
  rating      Int       @db.SmallInt
  comment     String?
  status      String    @default("NEW") @db.VarChar(16)
  admin_note  String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
  bookings    bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trip_reviews_booking_fk")
  customers   customers @relation(fields: [customer_id], references: [user_id], onUpdate: NoAction, map: "trip_reviews_customer_fk")

  @@index([driver_id, created_at(sort: Desc)], map: "trip_reviews_driver_idx")
  @@index([rating, created_at(sort: Desc)], map: "trip_reviews_rating_idx")
  @@index([status, created_at(sort: Desc)], map: "trip_reviews_status_idx")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                                                     String             @id @db.Uuid
  name                                                   String             @db.VarChar(120)
  email                                                  String             @unique @db.VarChar(180)
  password                                               String             @db.VarChar(255)
  phone                                                  String?            @unique @db.VarChar(20)
  role                                                   Role               @default(USER)
  is_active                                              Boolean            @default(true)
  created_at                                             DateTime           @default(now())
  updated_at                                             DateTime
  audit_logs                                             audit_logs[]
  booking_requests_booking_requests_customer_idTousers   booking_requests[] @relation("booking_requests_customer_idTousers")
  booking_requests_booking_requests_handled_by_idTousers booking_requests[] @relation("booking_requests_handled_by_idTousers")
  bookings                                               bookings[]
  customers                                              customers?
  device_tokens                                          device_tokens[]
  drivers                                                drivers?
  idempotency_keys                                       idempotency_keys[]
  ledger_entries                                         ledger_entries[]
  refresh_tokens                                         refresh_tokens[]

  @@index([created_at])
  @@index([phone])
  @@index([role])
}

model vehicle_catalog {
  id             Int      @id @default(autoincrement())
  key            String   @unique @db.VarChar(24)
  name           String   @db.VarChar(60)
  seats          Int
  blurb          String   @db.VarChar(160)
  detail         String   @db.VarChar(1000)
  luggage        String   @db.VarChar(60)
  glyph          String   @default("🚗") @db.VarChar(8)
  transmission   String?  @db.VarChar(16)
  fuel           String?  @db.VarChar(16)
  rating         Decimal? @db.Decimal(3, 2)
  trips          Int?
  hero_url       String?
  hero_public_id String?  @db.VarChar(200)
  images         Json     @default("[]")
  sort_order     Int      @default(0)
